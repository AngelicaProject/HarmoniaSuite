{
  "name": "@harmonia-suite/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for Harmonia Suite",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "npm run build && electron .",
    "package": "node node_modules/electron/install.js && node scripts/package-payload.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "electron": "^44.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
